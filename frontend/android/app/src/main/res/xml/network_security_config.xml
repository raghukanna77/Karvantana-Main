<?xml version="1.0" encoding="utf-8"?>
<!--
  KARVANTANA network security.

  Android's network security config does NOT support IP ranges like
  192.168.0.0/16 — a <domain> entry for "192.168.0.0" would only match that
  literal IP. What actually works:

    • Android 10+ : the <base-config> below applies to bare-IP origins too,
      so http://192.168.x.x / http://10.x.x.x development backends work.
    • Android 7–9 : some WebView versions do not treat IPs as domains, so
      LAN cleartext can still be blocked on those older devices. Production
      (HTTPS on a named domain) is unaffected everywhere — see
      docs/CLOUD_DEPLOYMENT.md.

  The public internet stays HTTPS-only: cleartext is enabled only in the
  <base-config> as a pragmatic dev shim, and the app itself runs on
  https://localhost (Capacitor androidScheme) with mixed content allowed
  (capacitor.config.json → android.allowMixedContent) so it can reach a
  plain-HTTP LAN backend.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- System CAs only: user-installed CAs are NOT trusted, matching
                 default production posture. Add a <debug-overrides> block
                 locally if you need to intercept traffic with a proxy. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
